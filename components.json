{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "stone",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@7ovr": "https://7ovr.com/r/{name}.json",
    "@charts": "https://ui.shadcn.com/r/styles/new-york-v4/{name}.json",
    "@efferd": "https://efferd.com/r/{style}/{name}.json",
    "@magicui": "https://magicui.design/r/{name}",
    "@nusaiba": "https://nusaiba.dev/r/base-nova/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@ai-elements": "https://ai-sdk.dev/elements/api/registry/{name}.json",
    "@prompt-kit": "https://www.prompt-kit.com/c/{name}.json"
  }
}
